rules_version = '2';

// Kairos Purpose security rules. Paste this whole file into
// Firebase console → Firestore Database → Rules, then click Publish.
// Nothing here needs editing: the first account created in the app
// becomes the owner, and the owner decides who else gets in.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }

    function isOwner() {
      return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid;
    }
    function isMember() {
      return signedIn() && (isOwner() ||
        (exists(memberDoc()) && get(memberDoc()).data.active == true));
    }

    // Who the owner is. Anyone may check whether setup is done; it can be
    // claimed exactly once, by the account claiming it, and never changed.
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !exists(ownerDoc())
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // The team list. Members can see it; only the owner adds or removes people.
    // Anyone can change their own username (and record their own login email), nothing else.
    match /members/{uid} {
      allow read: if isMember();
      allow write: if isOwner();
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["username", "email"])
        && request.resource.data.get("email", "") == request.auth.token.email;
    }

    // Username → login lookup used on the sign-in screen. Anyone can look up one
    // name (not list them). People manage their own entry; the owner manages all.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner() || (isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email);
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // Inventory and item photos: anyone active on the team.
    match /{collection}/{docId} {
      allow read, write: if isMember()
        && collection in ["items", "bins", "stock", "log", "photos"];
    }
  }
}
